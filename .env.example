# CookChase environment variables
# =================================
# All site content is managed in the admin panel (/admin/settings).
# No API keys are strictly required to run the site.

# --- Deployment -----------------------------------------------------------
# Canonical production URL. Overrides the site_url setting from the admin
# panel and drives sitemap.xml, robots.txt, canonical links and JSON-LD.
SITE_URL="https://cookchase.com"

# Where the SQLite database lives (the site's only data store).
#   DATA_DIR       -> directory holding cookchase.db      (default: ./data)
#   DATABASE_PATH  -> full path to the .db file           (overrides DATA_DIR)
# On Vercel serverless these paths are ephemeral — see DEPLOYMENT.md.
DATA_DIR="./data"
# DATABASE_PATH=""

# Port the production server listens on (next start).
PORT="3000"

# --- Admin session --------------------------------------------------------
# Secret used for admin sessions (reserved; a random value is used if empty).
ADMIN_SESSION_SECRET=""

# --- Optional integrations ------------------------------------------------
# AdSense client ID (also configurable in /admin/ads). Leave empty to disable.
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-XXXXXXXXXXXXXXXX"

# --- Stripe payments (Pro subscriptions) ----------------------------------
# Powers the Pro upgrade on /pricing. These vars are OPTIONAL: the same values
# can be set in /admin/settings (Payments section). Env vars override the
# admin-panel values, which is handy for production deployments.
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_MONTHLY="price_..."
# STRIPE_PRICE_YEARLY="price_..."

# --- Email notifications (SMTP) -------------------------------------------
# Admin gets an email when a new comment awaits moderation. These vars are
# OPTIONAL: the same values can be set in /admin/settings (Email
# notifications section). Env vars override the admin-panel values.
# Leave SMTP_ENABLED="" to manage everything from the admin panel instead.
# SMTP_ENABLED="1"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="0"            # 1 for port 465 (SSL), 0 for 587 (STARTTLS)
# SMTP_USER="notifications@cookchase.com"
# SMTP_PASS="app-password-or-api-key"
# SMTP_FROM="notifications@cookchase.com"
# SMTP_FROM_NAME="CookChase"
# SMTP_TO="admin@cookchase.com"
