# CookChase deploy configuration — STAGING environment.
# Copy to `.env.deploy.staging` and fill in your staging server details.
# Run: ./deploy.sh --env staging   (or use --pipeline to test staging first)

# SSH target — your staging server (IP or hostname, required)
DEPLOY_HOST=203.0.113.20

# SSH user (default: root) and path on the server (default: /opt/cookchase)
DEPLOY_USER=root
DEPLOY_PATH=/opt/cookchase
DEPLOY_PORT=22

# Path to an SSH private key (optional — omit to use the default agent/key)
# DEPLOY_KEY=~/.ssh/id_ed25519

# Restart strategy: docker (default) | pm2
DEPLOY_MODE=docker

# Public URL of the STAGING site — used for the post-deploy health check.
# Staging usually lives on a subdomain so it never touches production traffic.
DEPLOY_SITE_URL=https://staging.cookchase.com

# How many local + remote database backups to keep (default: 14)
BACKUP_KEEP=14

# Extra URL paths (space-separated) checked after deploy — must return 2xx/3xx
# DEPLOY_CHECK_PATHS="/ /pricing /tools/recipe-scaler"

# --- Deploy notifications (optional) -----------------------------------------
# Set DEPLOY_NOTIFY=1 to get a success/failure message after every deploy with
# the HTTP status, deploy duration, and backup counts.
DEPLOY_NOTIFY=0

# Choose one: telegram | slack | discord
# DEPLOY_WEBHOOK_TYPE=slack

# For Slack or Discord: the incoming-webhook URL.
# DEPLOY_WEBHOOK_URL=https://hooks.slack.com/services/<REPLACE_WITH_YOUR_WEBHOOK>

# For Telegram: a bot token + chat id (webhook URL is not used).
# DEPLOY_TELEGRAM_TOKEN=123456789:AAExampleBotToken
# DEPLOY_TELEGRAM_CHAT_ID=123456789
